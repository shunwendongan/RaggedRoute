{
  "schema_version": "codex.kernel-research.v1",
  "commands": {
    "build": [
      "cmd /d /c \"set RAGGEDROUTE_FETCH_REFERENCES=ON&& call scripts\\configure_windows.bat rtx3080-sm86-release\"",
      "cmd /d /c call scripts\\build_windows.bat rtx3080-sm86-release"
    ],
    "correctness": [
      "python scripts\\repository_checks.py",
      "python -m unittest discover -s tests -p test_*.py",
      "ctest --preset test-rtx3080-sm86-release --output-on-failure",
      "python scripts\\run_sanitizers.py --build-dir out\\build\\rtx3080-sm86-release --output-dir out\\research\\six-ops-v3\\sanitizer"
    ],
    "smoke": [
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\operators\\grouped_gemm\\benchmark\\candidate_v3_smoke.json --output out\\research\\six-ops-v3\\grouped-v3-smoke.jsonl",
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\operators\\permute\\benchmark\\candidate_v3_smoke.json --output out\\research\\six-ops-v3\\permute-v3-smoke.jsonl",
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\project\\benchmark\\route_trace_smoke.json --output out\\research\\six-ops-v3\\route-trace-smoke.jsonl"
    ],
    "release": [
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\operators\\grouped_gemm\\benchmark\\candidate_v3_release.json --output out\\research\\six-ops-v3\\grouped-v3-release.jsonl",
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\operators\\permute\\benchmark\\candidate_v3_release.json --output out\\research\\six-ops-v3\\permute-v3-release.jsonl",
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\operators\\permute\\benchmark\\candidate_v3_library_release.json --output out\\research\\six-ops-v3\\permute-v3-vllm-release.jsonl",
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\project\\benchmark\\six_ops_v3_release.json --output out\\research\\six-ops-v3\\six-ops-v3-release.jsonl",
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\project\\benchmark\\route_trace_release_placeholder.json --output out\\research\\six-ops-v3\\route-trace-placeholder-release.jsonl",
      "python scripts\\evaluate_promotion.py --input out\\research\\six-ops-v3\\grouped-v3-release.jsonl --baseline cutlass_grouped --candidate cuda_grouped_sm86_fp32_v3 --policy configs\\policies\\grouped_gemm_v3_promotion.json --output out\\research\\six-ops-v3\\grouped-v3-decision.json --markdown out\\research\\six-ops-v3\\grouped-v3-decision.md",
      "python scripts\\evaluate_promotion.py --input out\\research\\six-ops-v3\\permute-v3-release.jsonl --baseline cuda_token_owned_top2 --candidate cuda_candidate_v3 --policy configs\\policies\\token_permute_v3_promotion.json --output out\\research\\six-ops-v3\\permute-v3-decision.json --markdown out\\research\\six-ops-v3\\permute-v3-decision.md",
      "python scripts\\evaluate_promotion.py --input out\\research\\six-ops-v3\\permute-v3-vllm-release.jsonl --baseline vllm_moe_permute --candidate cuda_candidate_v3_from_ids --policy configs\\policies\\token_permute_v3_vllm_retention.json --output out\\research\\six-ops-v3\\permute-v3-vllm-decision.json --markdown out\\research\\six-ops-v3\\permute-v3-vllm-decision.md",
      "python scripts\\evaluate_promotion.py --input out\\research\\six-ops-v3\\six-ops-v3-release.jsonl --baseline cuda_postlogit_integrated_latest --candidate cuda_postlogit_research_v3 --policy configs\\policies\\cuda_v3_promotion.json --output out\\research\\six-ops-v3\\l3-v3-decision.json --markdown out\\research\\six-ops-v3\\l3-v3-decision.md",
      "python scripts\\evaluate_promotion.py --input out\\research\\six-ops-v3\\route-trace-placeholder-release.jsonl --baseline cuda_postlogit_integrated_latest --candidate cuda_postlogit_research_v3 --policy configs\\policies\\cuda_v3_real_trace_promotion.json --output out\\research\\six-ops-v3\\real-trace-decision.json --markdown out\\research\\six-ops-v3\\real-trace-decision.md",
      "python scripts\\build_v3_portfolio_evidence.py --decision grouped out\\research\\six-ops-v3\\grouped-v3-decision.json --decision permute out\\research\\six-ops-v3\\permute-v3-decision.json --decision permute_vllm out\\research\\six-ops-v3\\permute-v3-vllm-decision.json --decision l3 out\\research\\six-ops-v3\\l3-v3-decision.json --decision real_trace out\\research\\six-ops-v3\\real-trace-decision.json --output-dir out\\research\\six-ops-v3\\compact-evidence --archive out\\research\\six-ops-v3\\compact-evidence.zip"
    ]
  },
  "benchmark": {
    "binary": "out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe",
    "profile_cases": [
      {
        "name": "grouped-v3-uniform-t2048",
        "arguments": ["--operator", "grouped_gemm", "--variant", "cuda_grouped_sm86_fp32_v3", "--level", "l2", "--warmup", "20", "--profile-once", "--param", "T=2048", "--param", "E=64", "--param", "top_k=2", "--param", "K=128", "--param", "N=128", "--param", "distribution=uniform"]
      },
      {
        "name": "permute-v3-tile2-t4096-k1024",
        "arguments": ["--operator", "token_permute", "--variant", "cuda_candidate_v3", "--level", "l2", "--warmup", "20", "--profile-once", "--param", "T=4096", "--param", "E=64", "--param", "top_k=2", "--param", "K=1024", "--param", "distribution=uniform"]
      },
      {
        "name": "l3-research-v3-zipf-t2048",
        "arguments": ["--suite", "chain_from_logits", "--variant", "cuda_postlogit_research_v3", "--level", "l3", "--warmup", "20", "--profile-once", "--param", "T=2048", "--param", "E=64", "--param", "K=128", "--param", "N=128", "--param", "distribution=zipf", "--param", "zipf_s=1.4"]
      }
    ],
    "kernel_regex": "token_permute_token_(tile4|tile2)_top2_kernel|grouped_gemm_register16x(32_sm86_v2|64_sm86_v3)_kernel"
  },
  "variants": {
    "baseline": "cuda_postlogit_integrated_latest",
    "candidate": "cuda_postlogit_research_v3"
  },
  "output": {
    "root": "out\\research\\six-ops-v3",
    "retention": {
      "keep_raw_for": ["baseline", "promoted", "final"],
      "rejected_candidate": "all"
    }
  },
  "promotion_policy": {
    "version": "six-ops-v3-l3-v1",
    "min_processes": 5,
    "median_speedup": 1.03,
    "p95_regression_tolerance": 0.03,
    "max_shape_regression": 0.05,
    "max_workspace_growth": 0.0
  }
}

