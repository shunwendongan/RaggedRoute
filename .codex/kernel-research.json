{
  "schema_version": "codex.kernel-research.v1",
  "commands": {
    "build": [
      "cmd /c scripts\\configure_windows.bat rtx3080-sm86-release",
      "cmd /c scripts\\build_windows.bat rtx3080-sm86-release"
    ],
    "correctness": [
      "ctest --preset test-rtx3080-sm86-release --output-on-failure",
      "python scripts/run_sanitizers.py --build-dir out/build/rtx3080-sm86-release --output-dir out/tensorcore/sanitizer --executable out/build/rtx3080-sm86-release/raggedroute_tensorcore_tests.exe"
    ],
    "smoke": [
      "out/build/rtx3080-sm86-release/raggedroute_benchmark.exe --list"
    ],
    "release": [
      "python scripts/tensorcore_experiment.py run --binary out/build/rtx3080-sm86-release/raggedroute_benchmark.exe --config configs/project/benchmark/tensorcore/screening.json --output out/tensorcore/screening.jsonl",
      "python scripts/tensorcore_experiment.py select --input out/tensorcore/screening.jsonl --output out/tensorcore/frozen.json",
      "python scripts/tensorcore_experiment.py run --binary out/build/rtx3080-sm86-release/raggedroute_benchmark.exe --config configs/project/benchmark/tensorcore/full.json --selection out/tensorcore/frozen.json --output out/tensorcore/full.jsonl"
    ]
  },
  "benchmark": {
    "binary": "out/build/rtx3080-sm86-release/raggedroute_benchmark.exe",
    "profile_cases": [
      {
        "name": "dense.fp16.1024cube",
        "arguments": [
          "--operator",
          "dense_gemm_tc",
          "--variant",
          "cuda_mma_async",
          "--level",
          "l2",
          "--profile-once",
          "--warmup",
          "20",
          "--param",
          "M=1024",
          "--param",
          "N=1024",
          "--param",
          "K=1024",
          "--param",
          "dtype=fp16"
        ],
        "kernel_regex": "dense_gemm_mma_kernel"
      }
    ],
    "kernel_regex": "(dense|grouped)_gemm_mma_kernel"
  },
  "variants": {
    "baseline": "same_precision_fastest_supported_library",
    "candidate": "frozen_mma_configuration_per_operator_dtype"
  },
  "output": {
    "root": "out/tensorcore",
    "retention": {
      "keep_raw_for": [
        "baseline",
        "promoted",
        "final"
      ],
      "rejected_candidate": "metrics-and-reason"
    }
  },
  "promotion_policy": {
    "version": "sm86-tensorcore-v1",
    "min_processes": 5,
    "median_speedup": 1.03,
    "p95_regression_tolerance": 0.03,
    "max_shape_regression": 0.05,
    "max_workspace_growth": 0.0
  }
}
