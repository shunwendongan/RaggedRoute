{
  "schema_version": "codex.kernel-research.v1",
  "commands": {
    "build": [
      "$env:RAGGEDROUTE_FETCH_REFERENCES='ON'; cmd /c scripts\\configure_windows.bat rtx3080-sm86-release",
      "$env:RAGGEDROUTE_FETCH_REFERENCES='ON'; cmd /c scripts\\build_windows.bat rtx3080-sm86-release"
    ],
    "correctness": [
      "ctest --preset test-rtx3080-sm86-release --output-on-failure",
      "python scripts\\run_sanitizers.py --build-dir out\\build\\rtx3080-sm86-release --output-dir out\\sanitizer\\rtx3080-unpermute-candidate"
    ],
    "smoke": [
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\benchmark_unpermute_candidate_smoke.json --output out\\benchmark\\unpermute-candidate-smoke.jsonl"
    ],
    "release": [
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\benchmark_unpermute_candidate_release.json --output out\\benchmark\\unpermute-candidate-release.jsonl",
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\benchmark_unpermute_candidate_chain_release.json --output out\\benchmark\\unpermute-candidate-chain-release.jsonl"
    ]
  },
  "benchmark": {
    "binary": "out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe",
    "profile_cases": [
      {
        "name": "unpermute.warp.t1024_n256",
        "arguments": [
          "--operator",
          "unpermute",
          "--variant",
          "cuda_warp_token_vec4",
          "--level",
          "l2",
          "--profile-once",
          "--warmup",
          "20",
          "--seed",
          "20260729",
          "--param",
          "T=1024",
          "--param",
          "E=64",
          "--param",
          "top_k=2",
          "--param",
          "N=256",
          "--param",
          "distribution=uniform"
        ],
        "kernel_regex": "unpermute_warp_token_vec4_kernel"
      },
      {
        "name": "unpermute.cta.t64_n1024",
        "arguments": [
          "--operator",
          "unpermute",
          "--variant",
          "cuda_warp_token_vec4",
          "--level",
          "l2",
          "--profile-once",
          "--warmup",
          "20",
          "--seed",
          "20260729",
          "--param",
          "T=64",
          "--param",
          "E=64",
          "--param",
          "top_k=2",
          "--param",
          "N=1024",
          "--param",
          "distribution=uniform"
        ],
        "kernel_regex": "unpermute_cta_token_vec4_kernel"
      }
    ],
    "kernel_regex": "unpermute_(warp|cta)_token_vec4_kernel"
  },
  "variants": {
    "baseline": "vllm_finalize_routing",
    "candidate": "cuda_warp_token_vec4"
  },
  "output": {
    "root": "out\\profile",
    "retention": {
      "keep_raw_for": [
        "baseline",
        "promoted",
        "final"
      ],
      "rejected_candidate": "metrics-and-reason"
    }
  },
  "promotion_policy": {
    "version": "unpermute-strict-v1",
    "min_processes": 5,
    "median_speedup": 1.05,
    "p95_regression_tolerance": 0.03,
    "max_shape_regression": 0.05,
    "max_workspace_growth": 0
  }
}
