{
  "schema_version": "codex.kernel-research.v1",
  "commands": {
    "build": [
      "$env:RAGGEDROUTE_FETCH_REFERENCES='ON'; cmd /c scripts\\configure_windows.bat rtx3080-sm86-release",
      "$env:RAGGEDROUTE_FETCH_REFERENCES='ON'; cmd /c scripts\\build_windows.bat rtx3080-sm86-release"
    ],
    "correctness": [
      "ctest --preset test-rtx3080-sm86-release --output-on-failure",
      "python scripts\\run_sanitizers.py --build-dir out\\build\\rtx3080-sm86-release --output-dir out\\sanitizer\\rtx3080-scan-final"
    ],
    "smoke": [
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\benchmark_scan_library_smoke.json --output out\\benchmark\\scan-library-smoke.jsonl"
    ],
    "release": [
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\benchmark_scan_library_release.json --output out\\benchmark\\scan-library-final.jsonl"
    ]
  },
  "benchmark": {
    "binary": "out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe",
    "profile_cases": [
      {
        "name": "scan.naive.e64",
        "arguments": [
          "--operator",
          "exclusive_scan",
          "--variant",
          "cuda_naive",
          "--level",
          "l1",
          "--profile-once",
          "--warmup",
          "20",
          "--seed",
          "20260803",
          "--param",
          "E=64",
          "--param",
          "R=4096"
        ],
        "kernel_regex": "exclusive_scan_naive_kernel"
      },
      {
        "name": "scan.cub_warp.e32",
        "arguments": [
          "--operator",
          "exclusive_scan",
          "--variant",
          "cub_warp_scan",
          "--level",
          "l1",
          "--profile-once",
          "--warmup",
          "20",
          "--seed",
          "20260803",
          "--param",
          "E=32",
          "--param",
          "R=4096"
        ],
        "kernel_regex": "warp_scan_kernel"
      },
      {
        "name": "scan.cub_block.e64",
        "arguments": [
          "--operator",
          "exclusive_scan",
          "--variant",
          "cub_block_scan",
          "--level",
          "l1",
          "--profile-once",
          "--warmup",
          "20",
          "--seed",
          "20260803",
          "--param",
          "E=64",
          "--param",
          "R=4096"
        ],
        "kernel_regex": "block_scan_kernel"
      }
    ],
    "kernel_regex": "exclusive_scan_naive_kernel|warp_scan_kernel|block_scan_kernel"
  },
  "variants": {
    "baseline": "cuda_naive",
    "candidate": "cub_block_scan"
  },
  "output": {
    "root": "profile\\scan-library-final",
    "retention": {
      "keep_raw_for": [
        "baseline",
        "final"
      ],
      "rejected_candidate": "metrics-and-reason"
    }
  },
  "promotion_policy": {
    "version": "scan-sm86-v1",
    "min_processes": 3,
    "median_speedup": 1.03,
    "p95_regression_tolerance": 0.03,
    "max_shape_regression": 0.05,
    "max_workspace_growth": 0
  }
}
