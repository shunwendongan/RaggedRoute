  },
  "promotion_policy": {
    "version": "evidence-only-v1",
    "min_processes": 3,
    "median_speedup": 1.05,
    "p95_regression_tolerance": 0.03,
    "max_shape_regression": 0.05,
    "max_workspace_growth": 0.25
  }
