{
  "schema_version": "codex.kernel-research.v1",
  "commands": {
    "build": [
      "$env:RAGGEDROUTE_FETCH_REFERENCES='ON'; cmd /c scripts\\configure_windows.bat rtx3080-sm86-release",
      "$env:RAGGEDROUTE_FETCH_REFERENCES='ON'; cmd /c scripts\\build_windows.bat rtx3080-sm86-release"
    ],
    "correctness": [
      "ctest --preset test-rtx3080-sm86-release --output-on-failure",
      "python scripts\\run_sanitizers.py --build-dir out\\build\\rtx3080-sm86-release --output-dir out\\sanitizer\\rtx3080-grouped-gemm-sm86-v1"
    ],
    "smoke": [
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\benchmark_grouped_gemm_candidate_smoke.json --output out\\benchmark\\grouped-gemm-smoke.jsonl"
    ],
    "release": [
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\benchmark_grouped_gemm_candidate_release.json --output out\\benchmark\\grouped-gemm-release.jsonl"
    ]
  },
  "benchmark": {
    "binary": "out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe",
    "profile_cases": [
      {"name": "grouped.naive.zipf14", "arguments": ["--operator", "grouped_gemm", "--variant", "cuda_naive", "--level", "l1", "--profile-once", "--warmup", "20", "--seed", "20260729", "--param", "T=512", "--param", "E=64", "--param", "top_k=2", "--param", "K=128", "--param", "N=128", "--param", "distribution=zipf", "--param", "zipf_s=1.4"], "kernel_regex": "grouped_gemm_naive_kernel"},
      {"name": "grouped.candidate_v4.zipf14", "arguments": ["--operator", "grouped_gemm", "--variant", "cuda_grouped_register16x32_async_full_v4", "--level", "l1", "--profile-once", "--warmup", "20", "--seed", "20260729", "--param", "T=512", "--param", "E=64", "--param", "top_k=2", "--param", "K=128", "--param", "N=128", "--param", "distribution=zipf", "--param", "zipf_s=1.4"], "kernel_regex": "grouped_gemm_register16x32_async_v3_kernel"}
    ],
    "kernel_regex": "grouped_gemm_naive_kernel|grouped_gemm_register16x32_async_v3_kernel"
  },
  "variants": {
    "baseline": "cutlass_grouped",
    "candidate": "cuda_grouped_sm86_fp32_v1"
  },
  "output": {
    "root": "profile",
    "retention": {
      "keep_raw_for": ["baseline", "final"],
      "rejected_candidate": "metrics-and-reason"
