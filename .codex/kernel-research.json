      "cmd /c scripts\\configure_windows.bat rtx3080-sm86-release",
      "cmd /c scripts\\build_windows.bat rtx3080-sm86-release"
    ],
    "correctness": [
      "ctest --preset test-rtx3080-sm86-release --output-on-failure",
      "python scripts\\run_sanitizers.py --build-dir out\\build\\rtx3080-sm86-release --output-dir out\\sanitizer\\rtx3080-permute-candidate"
    ],
    "smoke": [
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\benchmark_permute_candidate_smoke.json --output out\\benchmark\\permute-candidate-smoke.jsonl"
    ],
    "release": [
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\benchmark_permute_candidate_release.json --output out\\benchmark\\permute-candidate-release.jsonl",
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\benchmark_permute_library_release.json --output out\\benchmark\\permute-library-release.jsonl"
    ]
  },
  "benchmark": {
    "binary": "out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe",
    "profile_cases": [
      {"name": "permute.naive.anchor", "arguments": ["--operator", "token_permute", "--variant", "cuda_naive", "--level", "l1", "--profile-once", "--warmup", "5", "--seed", "20260729", "--param", "T=512", "--param", "E=64", "--param", "top_k=2", "--param", "K=256", "--param", "distribution=zipf", "--param", "zipf_s=1.4", "--param", "materialize_sorted_route=true"], "kernel_regex": "token_permute_naive_kernel"},
      {"name": "permute.candidate.anchor", "arguments": ["--operator", "token_permute", "--variant", "cuda_candidate", "--level", "l1", "--profile-once", "--warmup", "5", "--seed", "20260729", "--param", "T=512", "--param", "E=64", "--param", "top_k=2", "--param", "K=256", "--param", "distribution=zipf", "--param", "zipf_s=1.4", "--param", "materialize_sorted_route=true"], "kernel_regex": "token_permute_token_owned_top2_kernel"}
    ],
    "kernel_regex": "token_permute_token_owned_top2_kernel"
  },
  "variants": {"baseline": "cuda_naive", "candidate": "cuda_candidate"},
  "output": {
    "root": "out\\profile",
    "retention": {
