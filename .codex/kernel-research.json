{
  "schema_version": "codex.kernel-research.v1",
  "commands": {
    "build": [
      "cmd /c scripts\\configure_windows.bat rtx3080-sm86-release",
      "cmd /c scripts\\build_windows.bat rtx3080-sm86-release"
    ],
    "correctness": [
      "ctest --preset test-rtx3080-sm86-release --output-on-failure",
      "python scripts\\run_sanitizers.py --build-dir out\\build\\rtx3080-sm86-release --output-dir out\\sanitizer\\interview-portfolio"
    ],
    "smoke": [
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\project\\benchmark\\smoke.json --output out\\interview-portfolio\\smoke.jsonl"
    ],
    "release": [
      "python scripts\\run_benchmarks.py --binary out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe --config configs\\project\\benchmark\\interview_portfolio_release.json --output out\\interview-portfolio\\release.jsonl"
    ]
  },
  "benchmark": {
    "binary": "out\\build\\rtx3080-sm86-release\\raggedroute_benchmark.exe",
    "profile_cases": [
      {
        "name": "postlogit.uniform.t512_e64_k128_n128",
        "arguments": ["--suite", "chain_from_logits", "--variant", "cuda_postlogit_integrated_latest", "--level", "l3", "--profile-once", "--warmup", "20", "--seed", "20260828", "--param", "T=512", "--param", "E=64", "--param", "K=128", "--param", "N=128", "--param", "distribution=uniform"],
        "kernel_regex": "(topk_gate|histogram|exclusive_scan|token_permute|grouped_gemm|unpermute)_.*kernel"
      },
      {
        "name": "postlogit.zipf14.t512_e64_k128_n128",
        "arguments": ["--suite", "chain_from_logits", "--variant", "cuda_postlogit_integrated_latest", "--level", "l3", "--profile-once", "--warmup", "20", "--seed", "20260828", "--param", "T=512", "--param", "E=64", "--param", "K=128", "--param", "N=128", "--param", "distribution=zipf", "--param", "zipf_s=1.4"],
        "kernel_regex": "(topk_gate|histogram|exclusive_scan|token_permute|grouped_gemm|unpermute)_.*kernel"
      }
    ],
    "kernel_regex": "(dense_gemm|topk_gate|histogram|exclusive_scan|token_permute|grouped_gemm|unpermute)_.*kernel"
  },
  "variants": {
    "baseline": "strongest-comparable-library-or-exact-naive-envelope",
    "candidate": "strongest-in-tree-candidate-per-operator"
  },
  "output": {
    "root": "out\\interview-portfolio",
    "retention": {
      "keep_raw_for": ["baseline", "promoted", "final"],
      "rejected_candidate": "metrics-and-reason"
    }
  },
  "promotion_policy": {
    "version": "interview-portfolio-v1",
    "min_processes": 5,
    "median_speedup": 1.03,
    "p95_regression_tolerance": 0.03,
    "max_shape_regression": 0.05,
    "max_workspace_growth": 0.0
  }
}
